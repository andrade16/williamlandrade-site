{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@/components": ["./components"],
      "@/components/*": ["./components/*"],
      "@/styles/*": ["./app/styles/*"],
      "@/theme": ["./theme"],
      "@/theme/*": ["./theme/*"],
      "@/utils/*": ["./lib/*"],
      "@/lib": ["./lib"],
      "@/lib/*": ["./lib/*"]
    }
  },
  "exclude": ["node_modules", ".next"]
}
